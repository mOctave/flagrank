<!DOCTYPE html>
<html>
	<head>
		<%- include("../partials/head"); %>
	</head>
	<body>
		<%- include("../partials/navbar"); %>
		<h1>Civil Use of a State Ensign</h1>
		<p>Unfortunately, we're no longer allowed to show you that resource for legal reasons. Maybe you'd like to <a href="./">head home</a> instead?</p>
		<p><em>451 Unavailable For Legal Reasons</em></p>
		<div class="flagdisplay">
			<a href="/flag-<%- flags[0].key %>"><img src="/<%- flags[0].image %>" alt="#1 Flag: <%- flags[0].name %>"/></a>
			<a href="/flag-<%- flags[1].key %>"><img src="/<%- flags[1].image %>" alt="#2 Flag: <%- flags[1].name %>"/></a>
			<a href="/flag-<%- flags[2].key %>"><img src="/<%- flags[2].image %>" alt="#3 Flag: <%- flags[2].name %>"/></a>
			<a href="/flag-<%- flags[3].key %>"><img src="/<%- flags[3].image %>" alt="#4 Flag: <%- flags[3].name %>"/></a>
			<a href="/flag-<%- flags[4].key %>"><img src="/<%- flags[4].image %>" alt="#5 Flag: <%- flags[4].name %>"/></a>
		</div>
		<script src="/navbar.js"></script>
	</body>
</html>

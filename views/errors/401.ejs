<!DOCTYPE html>
<html>
	<head>
		<%- include("../partials/head"); %>
	</head>
	<body>
		<%- include("../partials/navbar"); %>
		<h1>Passport, Please</h1>
		<p>You'll need to provide proper credentials if you'd like to access that. Maybe you'd like to <a href="./">head home</a> instead?</p>
		<p><em>401 Unauthorized</em></p>
		<div id="flagdisplay">
			<img src="<%- flags[0] %>.svg" alt="#1 Flag: <%- flags[0] %>"/>
			<img src="<%- flags[1] %>.svg" alt="#2 Flag: <%- flags[1] %>"/>
			<img src="<%- flags[2] %>.svg" alt="#3 Flag: <%- flags[2] %>"/>
			<img src="<%- flags[3] %>.svg" alt="#4 Flag: <%- flags[3] %>"/>
			<img src="<%- flags[4] %>.svg" alt="#5 Flag: <%- flags[4] %>"/>
		</div>
		<script src="navbar.js"></script>
	</body>
</html>

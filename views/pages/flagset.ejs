<!DOCTYPE html>
<html>
	<head>
		<%- include("../partials/head"); %>
		<link rel="stylesheet" href="/flagset.css"/>
	</head>
	<body>
		<%- include("../partials/navbar"); %>
		<h1><%- flagset %></h1>
		<p>This flagset contains <%- flags.length %> flags.</p>
		<div class="flag-card-container">
			<% for (let flag of flags) { %>
				<a class="flag-card" href="/flag-<%- flag.key %>">
					<h2><%- flag.name %></h2>
					<div class="flag-image-container">
						<img src="/<%- flag.image %>" alt="The flag of <%- flag.name %>"/>
					</div>
					<span class="flag-rating"><%- Math.round(flag.rating) %></span>
				</a>
			<% } %>
		</div>
		<script src="/navbar.js"></script>
	</body>
</html>

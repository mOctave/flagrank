<!DOCTYPE html>
<html>
	<head>
		<%- include("../partials/head"); %>
		<link rel="stylesheet" href="leaderboard.css"/>
	</head>
	<body>
		<%- include("../partials/navbar"); %>
		<h1>Flagrank Leaderboards</h1>
		<p>Want to see how the different flags stack up? These leaderboards have all the data you could possibly want.</p>
		<div class="leaderboard-container">
			<div class="leaderboard">
				<h2>Highest Rating</h2>
				<div class="leaderboard-content"><%- ratings %></div>
			</div>
			<div class="leaderboard">
				<h2>Highest Winrate</h2>
				<div class="leaderboard-content"><%- winrate %></div>
			</div>
			<div class="leaderboard">
				<h2>Most Wins</h2>
				<div class="leaderboard-content"><%- wins %></div>
			</div>
			<div class="leaderboard">
				<h2>Most Losses</h2>
				<div class="leaderboard-content"><%- losses %></div>
			</div>
			<div class="leaderboard">
				<h2>Most Draws</h2>
				<div class="leaderboard-content"><%- draws %></div>
			</div>
			<div class="dummy-leaderboard"></div>
			<div class="dummy-leaderboard"></div>
			<div class="dummy-leaderboard"></div>
			<div class="dummy-leaderboard"></div>
		</div>
		<script src="/navbar.js"></script>
	</body>
</html>

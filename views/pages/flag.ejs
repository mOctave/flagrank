<!DOCTYPE html>
<html>
	<head>
		<%- include("../partials/head"); %>
		<link rel="stylesheet" href="/flag.css"/>
	</head>
	<body>
		<%- include("../partials/navbar"); %>
		<div class="titlecard">
			<div class="titlecard-icon">
				<img src="/img/flag/<%- flag.key.toLowerCase() %>.svg" alt="Image of the flag of <%- flag.name %>"/>
			</div>
			<div class="titlecard-content">
				<h1><%- flag.longName %></h1>
				<p>Rating: <%- Math.round(flag.rating) %></p>
				<p>Wins: <%- flag.wins %></p>
				<p>Losses: <%- flag.losses %></p>
				<p>Draws: <%- flag.draws %></p>
				<div class="flagset-links">
					<p>This flag is a part of the following sets:</p>
					<% for (let set of flag.flagsets) { %>
						<a class="flagset-link" href="/set/<%- set.replaceAll(" ", "_") %>"><%- set %></a>
					<% } %>
				</div>
			</div>
		</div>
			<h2>Rating History</h2>
			<svg class="rating-graph" xmlns="http://www.w3.org/2000/svg">
				<!--This SVG, including its dimensions and viewbox, is autofilled.-->
			</svg>
		</div>
		<script>
			window.flag = <%- JSON.stringify(flag) %>;
		</script>
		<script src="/navbar.js"></script>
		<script src="/rating-graph.js"></script>
	</body>
</html>
